      },
      "id": 4,
      "title": "Total Order Volume by Status",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (status) (ecommerce_orders_total)",
          "legendFormat": "{{status}}",
          "range": true,
          "refId": "A"
        }
      ]
    }
